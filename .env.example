# Salin berkas ini menjadi ".env" lalu sesuaikan nilainya.
# Berkas .env tidak boleh di-commit ke repositori.

# Port server (default: 3000)
PORT=3000

# Alamat website yang dicetak pada QR Code kemasan.
# Untuk pengujian lokal gunakan http://localhost:3000
# Untuk publikasi gunakan alamat domain, contoh: https://banafitbrow.example.com
SITE_URL=http://localhost:3000

# Kata sandi dashboard admin di /admin
# Ganti dengan kata sandi yang kuat sebelum website digunakan.
ADMIN_PASSWORD=ganti_dengan_kata_sandi_anda

# Nomor WhatsApp pemesanan dalam format internasional tanpa tanda "+".
# Data CONTOH, ganti dengan nomor resmi.
WHATSAPP_NOMOR=628xxxxxxxxxx